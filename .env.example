# 复制为 .env，或直接用 `b2m config` 交互式填写。
# 环境变量优先级高于 ~/.bili2music/config.toml

# --- 大模型（OpenAI 兼容，任选一家）---
B2M_LLM_PROVIDER=openai
B2M_LLM_BASE_URL=https://api.deepseek.com/v1
B2M_LLM_MODEL=deepseek-chat
B2M_LLM_API_KEY=

# --- 本地 Ollama（provider=ollama 时生效）---
B2M_OLLAMA_BASE_URL=http://127.0.0.1:11434
B2M_OLLAMA_MODEL=qwen2.5:7b

# --- B 站登录态（也可 `b2m login` 扫码获取，私密收藏夹必须）---
B2M_SESSDATA=
B2M_BILI_JCT=
B2M_DEDE_USER_ID=

# --- 下载 ---
B2M_OUTPUT_DIR=
B2M_AUDIO_FORMAT=mp3
B2M_AUDIO_QUALITY=192
B2M_MAX_RESULTS=20
B2M_CONCURRENCY=2
